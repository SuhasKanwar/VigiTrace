PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*
VIGITRACE_SERVER_URL=http://localhost:9000

# Where acquired evidence is written. Derived artifacts stay separate from source media.
EVIDENCE_DIR=./evidence

# Optional AI narration via NVIDIA NIM (OpenAI-compatible API). Leave the key
# blank to run without it: all analysis findings are produced deterministically
# and are unaffected, and the endpoint reports narration as "not configured".
#
# NIM entitlements are per-account. A model can appear in /v1/models and still
# return 404 for your key, so verify a model before pinning it here:
#   curl https://integrate.api.nvidia.com/v1/models -H "Authorization: Bearer $NVIDIA_API_KEY"
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-nemotron
