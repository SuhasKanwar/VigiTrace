PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=*
VIGITRACE_SERVER_URL=http://localhost:9000

# Where acquired evidence is written. Derived artifacts stay separate from source media.
EVIDENCE_DIR=./evidence

# Optional. Absent keys degrade analysis narration to a clear "not configured"
# state; all deterministic findings are produced either way.
GROQ_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
